{
  // Ejecutar y depurar (F5) en Visual Studio Code.
  // Elija la configuración en la lista de "Ejecutar y depurar".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome · tamaño celular",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-browser-flag=--window-size=412,915"]
    },
    {
      "name": "Chrome · pantalla completa",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Chrome · emuladores (datos ficticios)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag=--window-size=412,915",
        "--dart-define=USE_EMULATORS=true"
      ]
    },
    {
      "name": "Celular por cable (abrir http://localhost:8000)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": ["--web-hostname=127.0.0.1", "--web-port=8000"],
      "preLaunchTask": "Conectar celular (adb reverse)"
    }
  ]
}
